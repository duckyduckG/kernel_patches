From a28656d55c5798c661de471ec3e07a6574559d9d Mon Sep 17 00:00:00 2001
From: dianlujitao <dianlujitao@lineageos.org>
Date: Thu, 2 Jul 2020 20:04:28 +0800
Subject: [PATCH 062/178] arm64: dts: xiaomi: jason: Update gpio entry for
 camera

Change-Id: I246377552793face8083a5e3eb90aa7a8433ecbe
---
 .../xiaomi/mi/jason/jason-camera-sensor.dtsi  | 36 +++++++++----------
 1 file changed, 18 insertions(+), 18 deletions(-)

diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/mi/jason/jason-camera-sensor.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/mi/jason/jason-camera-sensor.dtsi
index 3c0773dfeada..041e3e9e7d0a 100644
--- a/arch/arm64/boot/dts/vendor/qcom/xiaomi/mi/jason/jason-camera-sensor.dtsi
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/mi/jason/jason-camera-sensor.dtsi
@@ -49,6 +49,8 @@
 		startup-delay-us = <4000>;
 		enable-active-high;
 		gpio = <&pm660l_gpios 4 0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_sensor_eldo4_default>;
 	};
 
 	vana_gpio_supply: vana_gpio_supply {
@@ -216,7 +218,8 @@
 		qcom,gpio-no-mux = <0>;
 		pinctrl-names = "cam_default", "cam_suspend";
 		pinctrl-0 = <&cam_sensor_mclk1_active
-				 &cam_sensor_front_active_jason>;
+				 &cam_sensor_front_active_jason
+				 &cam_sensor_eldo3_default>;
 		pinctrl-1 = <&cam_sensor_mclk1_suspend
 				 &cam_sensor_front_suspend>;
 		gpios = <&tlmm 33 0>,
@@ -380,23 +383,20 @@
 };
 
 &pm660l_gpios {
-	gpio@c300 { /* GPIO4 -CAMERA SENSOR 0 VDIG*/
-		qcom,mode = <1>;                /* Output */
-		qcom,pull = <5>;                /* No Pull */
-		qcom,vin-sel = <0>;             /* VIN1 GPIO_LV */
-		qcom,src-sel = <0>;             /* GPIO */
-		qcom,invert = <0>;              /* Invert */
-		qcom,master-en = <1>;           /* Enable GPIO */
-		status = "ok";
+	cam_sensor_eldo3 {
+		cam_sensor_eldo3_default: cam_sensor_eldo3_default {
+			pins = "gpio3";
+			function = "normal";
+			output-high;
+			bias-disable;
+		};
 	};
-
-	gpio@c200 { /* GPIO3 -CAMERA SENSOR 2 VDIG*/
-		qcom,mode = <1>;                /* Output */
-		qcom,pull = <5>;                /* No Pull */
-		qcom,vin-sel = <0>;             /* VIN1 GPIO_LV */
-		qcom,src-sel = <0>;             /* GPIO */
-		qcom,invert = <0>;              /* Invert */
-		qcom,master-en = <1>;           /* Enable GPIO */
-		status = "ok";
+	cam_sensor_eldo4 {
+		cam_sensor_eldo4_default: cam_sensor_eldo4_default {
+			pins = "gpio4";
+			function = "normal";
+			output-low;
+			bias-disable;
+		};
 	};
 };
-- 
2.49.0

