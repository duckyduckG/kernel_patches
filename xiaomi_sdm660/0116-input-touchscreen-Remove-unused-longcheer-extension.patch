-	if (IS_ERR_OR_NULL(proc_entry_tp)) {
-		TP_LOGE("add /proc/tp_work error \n");
-		return -1;
-	}
-	TP_LOGW("/proc/tp_work is okay!\n");
-
-	return 0;
