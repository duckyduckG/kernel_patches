+	}
+
+	for (i = 0, offset = td43xx_rt95_report_size; i < tx_num * rx_num; i++) {
+		td43xx_rt95_part_two[i] = (signed short)(f54->report_data[offset]) |
+								((signed short)(f54->report_data[offset + 1]) << 8);
