+	if (td43xx_noise_max)
+		kfree(td43xx_noise_data);
+	td43xx_noise_max = (unsigned short *)kzalloc(noise_report_size, GFP_KERNEL);
+	if (!td43xx_noise_max) {
+		dev_err(rmi4_data->pdev->dev.parent,
+				"%s: Failed to alloc mem for td43xx_noise_max\n",
+				__func__);
