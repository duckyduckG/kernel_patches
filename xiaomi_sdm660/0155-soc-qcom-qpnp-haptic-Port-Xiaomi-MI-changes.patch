 	/*
 	 * The frequency of 19.2Mzhz RC clock is subject to variation. Currently
@@ -2947,7 +3176,12 @@ static int qpnp_hap_parse_dt(struct qpnp_hap *hap)
 			hap->drive_period_code_min_limit_percent_variation =
