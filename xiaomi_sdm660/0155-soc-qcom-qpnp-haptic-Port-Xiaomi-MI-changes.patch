 	hap->init_drive_period_code =
 			 hap->wave_play_rate_us / QPNP_HAP_RATE_CFG_STEP_US;
+#ifdef CONFIG_MACH_MI
+	hap->wave_play_rate_frequency = 1000000 / hap->wave_play_rate_us;
