+++ b/drivers/input/touchscreen/nvt_touch_a/nt36xxx.h
@@ -100,6 +100,7 @@ struct nvt_ts_data {
 	const struct nvt_ts_mem_map *mmap;
 	uint8_t carrier_system;
 	uint16_t nvt_pid;
+	struct wakeup_source *gesture_wakeup;
 };
 
 #if NVT_TOUCH_PROC
