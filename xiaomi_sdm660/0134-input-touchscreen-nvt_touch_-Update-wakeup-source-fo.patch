Subject: [PATCH 134/178] input: touchscreen: nvt_touch_*: Update wakeup source
 for 4.19

Change-Id: Iee2d4824b8bf2595f1fd870401664f7444920f1d
---
 drivers/input/touchscreen/nvt_touch_a/nt36xxx.c   | 6 ++----
 drivers/input/touchscreen/nvt_touch_a/nt36xxx.h   | 1 +
 drivers/input/touchscreen/nvt_touch_d2s/nt36xxx.c | 6 ++----
 drivers/input/touchscreen/nvt_touch_d2s/nt36xxx.h | 1 +
 drivers/input/touchscreen/nvt_touch_e7s/nt36xxx.c | 6 ++----
 drivers/input/touchscreen/nvt_touch_e7s/nt36xxx.h | 1 +
 drivers/input/touchscreen/nvt_touch_f7a/nt36xxx.c | 6 ++----
 drivers/input/touchscreen/nvt_touch_f7a/nt36xxx.h | 1 +
 8 files changed, 12 insertions(+), 16 deletions(-)

diff --git a/drivers/input/touchscreen/nvt_touch_a/nt36xxx.c b/drivers/input/touchscreen/nvt_touch_a/nt36xxx.c
index 09230d6f23bf..d7cd7c622e6c 100644
--- a/drivers/input/touchscreen/nvt_touch_a/nt36xxx.c
+++ b/drivers/input/touchscreen/nvt_touch_a/nt36xxx.c
@@ -640,8 +640,6 @@ static int32_t nvt_flash_proc_init(void)
 /* function page definition */
 #define FUNCPAGE_GESTURE         1
 
-static struct wakeup_source gesture_wakeup;
-
 /*******************************************************
 Description:
 	Novatek touchscreen wake up gesture key report function.
@@ -996,7 +994,7 @@ static irqreturn_t nvt_ts_irq_handler(int32_t irq, void *dev_id)
 {
 #if WAKEUP_GESTURE
 	if (bTouchIsAwake == 0) {
-		__pm_wakeup_event(&gesture_wakeup, msecs_to_jiffies(5000));
+		__pm_wakeup_event(ts->gesture_wakeup, msecs_to_jiffies(5000));
 	}
 #endif
 	queue_work(nvt_wq, &ts->nvt_work);
@@ -1267,7 +1265,7 @@ static int32_t nvt_ts_probe(struct i2c_client *client, const struct i2c_device_i
 	for (retry = 0; retry < (sizeof(gesture_key_array) / sizeof(gesture_key_array[0])); retry++) {
 		input_set_capability(ts->input_dev, EV_KEY, gesture_key_array[retry]);
 	}
-	wakeup_source_init(&gesture_wakeup, "poll-wake-lock");
+	ts->gesture_wakeup = wakeup_source_register(NULL, "poll-wake-lock");
 #ifdef CONFIG_TOUCHSCREEN_COMMON
 	ret = tp_common_set_double_tap_ops(&double_tap_ops);
 	if (ret < 0) {
diff --git a/drivers/input/touchscreen/nvt_touch_a/nt36xxx.h b/drivers/input/touchscreen/nvt_touch_a/nt36xxx.h
index 8323cf9b98ad..784e7129bdc4 100644
