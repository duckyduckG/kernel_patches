From eb79ccea1efe38375aabb95d9aced725ed477c56 Mon Sep 17 00:00:00 2001
From: Davide Garberi <dade.garberi@gmail.com>
Date: Tue, 25 Feb 2020 13:05:30 +0100
Subject: [PATCH 037/178] arm64: dts: xiaomi: wayne/jasmine: Add support for
 Oreo board-id

Change-Id: Ia49573b506d6b0d491126de6e7380c1b003c4c19
---
 arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-jasmine.dts | 2 +-
 arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-wayne.dts   | 5 +----
 2 files changed, 2 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-jasmine.dts b/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-jasmine.dts
index b5d5667b6b6d..23682d9b0478 100644
--- a/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-jasmine.dts
+++ b/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-jasmine.dts
@@ -21,7 +21,7 @@
 / {
 	model = "Qualcomm Technologies, Inc. SDM 660 PM660 + PM660L MTP";
 	compatible = "qcom,sdm660-mtp", "qcom,sdm660", "qcom,mtp";
-	qcom,board-id = <8 0>;
+	qcom,board-id = <0x030008 0>, <8 0>;
 	qcom,pmic-id = <0x0001001b 0x0101011a 0x0 0x0>,
 			<0x0001001b 0x0201011a 0x0 0x0>,
 			<0x0001001b 0x0102001a 0x0 0x0>;
diff --git a/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-wayne.dts b/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-wayne.dts
index ae33282f6bd9..979a4817d5ce 100644
--- a/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-wayne.dts
+++ b/arch/arm64/boot/dts/vendor/qcom/sdm660-mtp-wayne.dts
@@ -21,13 +21,10 @@
 / {
 	model = "Qualcomm Technologies, Inc. SDM 660 PM660 + PM660L MTP WAYNE";
 	compatible = "qcom,sdm660-mtp", "qcom,sdm660", "qcom,mtp";
-	qcom,board-id = <0x50008 0>;
+	qcom,board-id = <0x020008 0>, <0x50008 0>;
 	qcom,pmic-id = <0x0001001b 0x0101011a 0x0 0x0>,
 			<0x0001001b 0x0201011a 0x0 0x0>,
 			<0x0001001b 0x0102001a 0x0 0x0>;
-
-       
-
 };
 
