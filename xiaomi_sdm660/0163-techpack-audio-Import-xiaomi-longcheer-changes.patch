+		rdc_max = SPEAKER_RDC_MAX;
+	} else {
+		pr_err("%s: invalid param ch: %d\n", __func__, ch);
+		return false;
+	}
+
+	if (rdc > rdc_min && rdc < rdc_max)
+		return true;
+
+	pr_info("%s: rdc=%d invalid, [%d, %d] \n", __func__, rdc, rdc_min, rdc_max);
+	return false;
+}
