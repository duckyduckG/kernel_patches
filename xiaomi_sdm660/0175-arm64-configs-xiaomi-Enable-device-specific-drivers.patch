 7 files changed, 62 insertions(+)

diff --git a/arch/arm64/configs/vendor/xiaomi/jason.config b/arch/arm64/configs/vendor/xiaomi/jason.config
index 8063b63d7270..b1b26674e465 100644
--- a/arch/arm64/configs/vendor/xiaomi/jason.config
+++ b/arch/arm64/configs/vendor/xiaomi/jason.config
@@ -1,2 +1,8 @@
 # Platform
 CONFIG_MACH_XIAOMI_JASON=y
+
+# Touchscreen
+CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_FORCE=y
