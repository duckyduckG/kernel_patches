From b0f5e03f7d627444eb5c99eaa97759650daa4566 Mon Sep 17 00:00:00 2001
From: Edwin Moquete <edwinmmoquete@gmail.com>
Date: Wed, 28 Oct 2020 13:13:47 +0000
Subject: [PATCH 065/178] arm64: dts: xiaomi: longcheer: Update thermal config

Change-Id: I38d5921258086d440bd9ee8eab5f33dbfe00c7e5
---
 .../longcheer/common/longcheer-pm660.dtsi     | 30 +++++++++++++------
 .../common/longcheer-sdm660-base.dtsi         |  7 -----
 2 files changed, 21 insertions(+), 16 deletions(-)

diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-pm660.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-pm660.dtsi
index d9bac85094ab..2b4642c798e1 100644
--- a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-pm660.dtsi
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-pm660.dtsi
@@ -34,16 +34,28 @@
 };
 
 &pm660_vadc {
-	chan@50 {
+	backlight_therm {
+		reg = <ADC_AMUX_THM4_PU2>;
 		label = "backlight_therm";
-		reg = <0x50>;
-		qcom,decimation = <2>;
-		qcom,pre-div-channel-scaling = <0>;
-		qcom,calibration-type = "ratiometric";
-		qcom,scale-function = <2>;
-		qcom,hw-settle-time = <2>;
-		qcom,fast-avg-setup = <0>;
-		qcom,vadc-thermal-node;
+		qcom,ratiometric;
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+	};
+};
+
+&thermal_zones {
+	backlight_therm {
+		polling-delay-passive = <0>;
+		polling-delay = <0>;
+		thermal-governor = "user_space";
+		thermal-sensors = <&pm660_adc_tm ADC_AMUX_THM4_PU2>;
+		trips {
+			active-config0 {
+				temperature = <125000>;
+				hysteresis = <1000>;
+				type = "passive";
+			};
+		};
 	};
 };
 
diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
index 82f355065edc..371e84f3bc9b 100644
--- a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
@@ -21,13 +21,6 @@
 &soc {
 	/delete-node/ qcom,qbt1000;
 
-	qcom,sensor-information {
-		sensor_information22: qcom,sensor-information-22 {
-			qcom,sensor-type = "adc";
-			qcom,sensor-name = "backlight_therm";
-		};
-	};
-
 	sn_fuse: snfuse@0xA4128 {
 		compatible = "qcom,sn-fuse";
 		reg = <0x786134 0x4>,
-- 
2.49.0

