+static int ft8719_open_test(bool *test_result)
+{
+    int ret = 0;
+    bool tmp_result = false;
+    int min = 0;
+    int max = 0;
+    u8 reg_vgh = 0;
+    u8 reg_vgl = 0;
+    u8 k1 = 0;
+    u8 k2 = 0;
+    int tx_num = 0;
