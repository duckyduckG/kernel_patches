+	for (k = 0; k < Key_Channel; k++) {
+		iArrayIndex = Y_Channel * X_Channel + k;
+		if (ts->carrier_system) {
+			xdata[iArrayIndex] = (uint16_t)xdata[iArrayIndex];
+		} else {
+			xdata[iArrayIndex] = (int16_t)xdata[iArrayIndex];
+		}
+	}
