+#define FW_BIN_VER_OFFSET 0x1A000
+#define FW_BIN_VER_BAR_OFFSET 0x1A001
+#define FLASH_SECTOR_SIZE 4096
+#define SIZE_64KB 65536
+#define BLOCK_64KB_NUM 4
