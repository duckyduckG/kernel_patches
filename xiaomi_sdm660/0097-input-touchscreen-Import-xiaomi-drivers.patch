+	retval = tcm_hcd->write_message(tcm_hcd,
+			CMD_GET_DYNAMIC_CONFIG,
+			&out_buf,
+			sizeof(out_buf),
+			&resp_buf,
+			&resp_buf_size,
+			&resp_length,
+			NULL,
