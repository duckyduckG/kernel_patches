+static short find_median(short* pdata, int num)
+{
+	int i,j;
+	short temp;
+	short *value;
+	short median;
+
+	value = (short *)kzalloc( num * sizeof(short), GFP_KERNEL);
+
+	for(i=0; i < num; i++)
+		*(value+i) = *(pdata+i);
+
+
+	for ( i=1; i <= num-1; i++)
+	{
+		for ( j=1; j <= num-i; j++)
+		{
+			if (*(value+j-1) <= *(value+j))
+			{
+			   temp = *(value+j-1);
+			   *(value+j-1)= *(value+j);
+			   *(value+j) = temp;
+			}
+			else
+				continue ;
+		}
+	}
+
+
+	if ( num % 2 == 0)
+		median = ( *(value+(num/2 -1)) + *(value+(num/2)) )/2;
+	else
+		median = *(value+(num/2));
+
+	if(value)
+		kfree(value);
+
+	return median;
+}
