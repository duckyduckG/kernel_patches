+		control.reg_99->integration_duration_lsb = ELEC_OPEN_INT_DUR_TWO_SHENCHAO;
+		control.reg_99->integration_duration_msb = (ELEC_OPEN_INT_DUR_TWO_SHENCHAO >> 8) & 0xff;
