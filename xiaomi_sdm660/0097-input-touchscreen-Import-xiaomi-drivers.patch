+        FTS_TEST_SAVE_ERR("\r\nEnter Factory fail");
+        goto TEST_ERR_FACTORY;
+    }
+
+    /* open test enable */
+    ret = write_reg(FACTORY_REG_OPEN_TEST_EN, 0x01);
