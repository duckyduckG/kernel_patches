+
+			k += 2;
+		}
+	}
+
+	/* step 8 */
+	/* generate the delta image, which is equeal to image2 - image1 */
+	/* unit is femtofarad (fF) */
+	for (i = 0; i < tx_num * rx_num; i++) {
+		p_rt92_delta_image[i] = p_rt92_image_2[i] - p_rt92_image_1[i];
