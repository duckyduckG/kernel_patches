+
+	p_rt92_image_1 = kzalloc(tx_num * rx_num * sizeof(signed short), GFP_KERNEL);
+	if (!p_rt92_image_1) {
+		dev_err(rmi4_data->pdev->dev.parent,
+				"%s: Failed to alloc mem for p_rt92_image_1\n",
