+/*******************************************************
+Description:
+Novatek touchscreen xdata sequence print show
+function.
+
+return:
+Executive outcomes. 0---succeed.
+ *******************************************************/
+static int32_t c_show(struct seq_file *m, void *v)
+{
+	int32_t i = 0;
+	int32_t j = 0;
+
+	LOG_ENTRY();
+	for (i = 0; i < ts->y_num; i++) {
+		for (j = 0; j < ts->x_num; j++) {
+			seq_printf(m, "%5d, ", xdata[i * ts->x_num + j]);
+		}
+		seq_puts(m, "\n");
+	}
