+
+	retval = secure_memcpy(testing_hcd->output.buf,
+			testing_hcd->output.buf_size,
+			testing_hcd->resp.buf,
+			testing_hcd->resp.buf_size,
+			testing_hcd->resp.data_length);
+	if (retval < 0) {
