+int32_t nvt_get_fw_info(void)
+{
+	uint8_t buf[64] = {0};
+	uint32_t retry_count = 0;
+	int32_t ret = 0;
+/* add tp-fw information by yangjiangzhu  2018/3/12 start */
+#if	NVT_READ_TP_FW
+	char fw_version[64];
+#endif
+/* add tp-fw information by yangjiangzhu  2018/3/12 end */
