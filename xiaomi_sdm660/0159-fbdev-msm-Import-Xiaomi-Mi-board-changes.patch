 	if (pinfo->dcs_cmd_by_left) {
 		if (ctrl->ndx != DSI_CTRL_LEFT)
 			goto end;
@@ -2029,10 +2220,48 @@ static void mdss_dsi_parse_esd_params(struct device_node *np,
 {
 	u32 tmp;
 	u32 i, status_len, *lenp;
+#ifdef CONFIG_MACH_MI
