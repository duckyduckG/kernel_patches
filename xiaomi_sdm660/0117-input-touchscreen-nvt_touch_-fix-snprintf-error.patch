+++ b/drivers/input/touchscreen/nvt_touch_d2s/nt36xxx_mp_ctrlram.c
@@ -1484,7 +1484,7 @@ static int32_t nvt_selftest_open(struct inode *inode, struct file *file)
 		 * Ex. nvt_pid = 500A
 		 *     mpcriteria = "novatek-mp-criteria-500A"
 		 */
-		snprintf(mpcriteria, PAGE_SIZE, "novatek-mp-criteria-%04X", ts->nvt_pid);
+		snprintf(mpcriteria, sizeof(mpcriteria), "novatek-mp-criteria-%04X", ts->nvt_pid);
 
 		nvt_mp_parse_dt(np, mpcriteria);
 	} else {
diff --git a/drivers/input/touchscreen/nvt_touch_e7s/nt36xxx_mp_ctrlram.c b/drivers/input/touchscreen/nvt_touch_e7s/nt36xxx_mp_ctrlram.c
index f5dbb0825b79..9a0cfeaf6f52 100644
--- a/drivers/input/touchscreen/nvt_touch_e7s/nt36xxx_mp_ctrlram.c
+++ b/drivers/input/touchscreen/nvt_touch_e7s/nt36xxx_mp_ctrlram.c
@@ -1484,7 +1484,7 @@ static int32_t nvt_selftest_open(struct inode *inode, struct file *file)
 		 * Ex. nvt_pid = 500A
 		 *     mpcriteria = "novatek-mp-criteria-500A"
 		 */
-		snprintf(mpcriteria, PAGE_SIZE, "novatek-mp-criteria-%04X", ts->nvt_pid);
+		snprintf(mpcriteria, sizeof(mpcriteria), "novatek-mp-criteria-%04X", ts->nvt_pid);
 
 		nvt_mp_parse_dt(np, mpcriteria);
 	} else {
diff --git a/drivers/input/touchscreen/nvt_touch_f7a/nt36xxx_mp_ctrlram.c b/drivers/input/touchscreen/nvt_touch_f7a/nt36xxx_mp_ctrlram.c
index fdeb40f6ca86..3995e44cd239 100644
