From c348bf878150aa93dc8d6a404eb52b231a2cad08 Mon Sep 17 00:00:00 2001
From: Davide Garberi <dade.garberi@gmail.com>
Date: Tue, 17 Sep 2019 17:15:20 +0200
Subject: [PATCH 046/178] arm64: dts: xiaomi: Rework the ramoops implementation

Change-Id: Id6203277f9388638ddd74b5ca7f58de394a073cd
---
 .../common/longcheer-sdm660-base.dtsi         | 11 +------
 .../common/longcheer-sdm660-ramoops.dtsi      | 31 +++++++++++++++++++
 2 files changed, 32 insertions(+), 10 deletions(-)
 create mode 100644 arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-ramoops.dtsi

diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
index f761f69f9063..82f355065edc 100644
--- a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-base.dtsi
@@ -15,18 +15,9 @@
 #include "longcheer-sdm660-mdss.dtsi"
 #include "longcheer-sdm660-mtp.dtsi"
 #include "longcheer-sdm660-pinctrl.dtsi"
+#include "longcheer-sdm660-ramoops.dtsi"
 
 /* sdm660.dtsi common diff */
-/ {
-	pstore_reserve_mem: pstore_reserve_mem_region@0 {
-		linux,reserve-contiguous-region;
-		linux,reserve-region;
-		linux,remove-completely;
-		reg = <0x0 0xA0000000 0x0 0x00400000>;
-		label = "pstore_reserve_mem";
-	};
-};
-
 &soc {
 	/delete-node/ qcom,qbt1000;
 
diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-ramoops.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-ramoops.dtsi
new file mode 100644
index 000000000000..a95ca350143e
--- /dev/null
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-ramoops.dtsi
@@ -0,0 +1,31 @@
