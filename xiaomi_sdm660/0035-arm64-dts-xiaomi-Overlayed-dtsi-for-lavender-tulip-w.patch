+	status = "okay";
+	tas2557@4c {
+		compatible = "ti,tas2557";
+		reg = <0x4c>;
+		#ti,load = <0>;   /* 0, 8Ohm; 1, 6Ohm; 2, 4Ohm */
+		#ti,channel = <0>;   /* 0, left channel; 1, right channel */
+		i2c-pull-up;
+		vdd-supply = <&pm660l_l6>;
+		vcc_i2c-supply = <&pm660l_l6>;
+		ti,cdc-reset-gpio = <&tlmm 77 0>;
