+		i2c-pull-up;
+		vdd-supply = <&pm660l_l6>;
+		vcc_i2c-supply = <&pm660l_l6>;
+		reset-gpio = <&tlmm 77 0>;
+		irq-gpio = <&tlmm 73 0>;
+		status = "ok";
+	};
+};
+
+/* sdm660-regulator common diff */
