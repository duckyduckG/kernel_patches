+				mnt_flags = "ro,barrier=1";
+				fsmgr_flags = "wait,verify";
+				status = "ok";
+			};
+		};
+	};
+};
+
+&qcom_seecom {
+	/delete-property/ qcom,fde-key-size;
+};
