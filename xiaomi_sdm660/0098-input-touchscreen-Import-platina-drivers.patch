+
+	NVT_proc_xiaomi_config_info_entry = proc_create(NVT_XIAOMI_CONFIG_INFO, 0444, NULL, &nvt_xiaomi_config_info_fops);
+
+	if (NVT_proc_xiaomi_config_info_entry == NULL) {
