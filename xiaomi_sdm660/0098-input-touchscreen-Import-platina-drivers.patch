+static const struct file_operations nvt_xiaomi_config_info_fops = {
+	.owner = THIS_MODULE,
+	.open = nvt_xiaomi_config_info_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
