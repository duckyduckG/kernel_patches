+
+	if (ts->carrier_system) {
+		printk("%s:RawData_CC_I:\n", __func__);
+
+#if TOUCH_KEY_NUM > 0
+		rawdata_cc_q_offset = Y_Channel * X_Channel * 7 + Y_Channel * 2 + Key_Channel * 7 + 2;
+#else
+		rawdata_cc_q_offset = Y_Channel * X_Channel * 7 + Y_Channel * 2;
+#endif /* #if TOUCH_KEY_NUM > 0 */
+	}
+
+	NVT_LOG("--\n");
+	return 0;
