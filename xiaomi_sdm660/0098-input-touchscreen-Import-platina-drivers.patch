+			NULL,
+			0);
+	if (retval < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to write command %s\n",
+				en ?
+				STR(CMD_ENTER_DEEP_SLEEP) :
+				STR(CMD_EXIT_DEEP_SLEEP));
+		goto exit;
+	}
+
+	retval = 0;
+
+exit:
+	kfree(resp_buf);
+
+	return retval;
+}
