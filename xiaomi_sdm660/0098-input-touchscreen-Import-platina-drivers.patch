+	retval = tcm_hcd->write_message(tcm_hcd,
+			CMD_SET_DYNAMIC_CONFIG,
+			out_buf,
+			sizeof(out_buf),
+			&resp_buf,
+			&resp_buf_size,
+			&resp_length,
+			NULL,
+			0);
+	if (retval < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to write command %s\n",
+				STR(CMD_SET_DYNAMIC_CONFIG));
+		goto exit;
+	}
+
+	retval = 0;
+
+exit:
+	kfree(resp_buf);
+
+	return retval;
+}
