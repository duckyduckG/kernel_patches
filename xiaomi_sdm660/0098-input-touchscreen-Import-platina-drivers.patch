+/*****************************************************************************
+*  Name: fts_report_event
+*  Brief:
+*  Input:
+*  Output:
+*  Return:
+*****************************************************************************/
+static void fts_report_event(struct fts_ts_data *data)
+{
+#if FTS_MT_PROTOCOL_B_EN
+	fts_input_report_b(data);
+#else
+	fts_input_report_a(data);
+#endif
