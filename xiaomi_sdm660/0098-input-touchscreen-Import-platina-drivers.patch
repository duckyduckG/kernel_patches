+
+	NVT_proc_xiaomi_lockdown_info_entry = proc_create(NVT_XIAOMI_LOCKDOWN_INFO, 0444, NULL, &nvt_xiaomi_lockdown_info_fops);
+
+	if (NVT_proc_xiaomi_lockdown_info_entry == NULL) {
