+		LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to write to flash\n");
+		goto run_app_firmware;
+	}
+
+	retval = 0;
+
+run_app_firmware:
+	if (tcm_hcd->switch_mode(tcm_hcd, FW_MODE_APPLICATION) < 0) {
+		LOGE(tcm_hcd->pdev->dev.parent,
+				"Failed to run application firmware\n");
+	}
+
+	tcm_hcd->update_watchdog(tcm_hcd, true);
+
+	return retval;
+}
