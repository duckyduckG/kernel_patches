+		LOGE(tcm_hcd->pdev->dev.parent,
+			"Failed to copy report data\n");
+	} else {
+		retval = readlen;
+	}
+
+	UNLOCK_BUFFER(testing_hcd->output);
+
+	mutex_unlock(&tcm_hcd->extif_mutex);
+
+	return retval;
