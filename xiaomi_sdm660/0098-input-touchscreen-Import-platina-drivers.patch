+ ***********************************************************************/
+static int ft8719_enter_factory_mode(void)
+{
+	int ret = 0;
+
+	ret = enter_factory_mode();
+	if (ret < 0) {
+		FTS_TEST_SAVE_INFO("enter factory mode fail, can't get tx/rx num");
+		return ret;
+	}
+	ret = ft8719_get_key_num();
+	if (ret < 0) {
+		FTS_TEST_SAVE_INFO("get key num fail");
+		return ret;
+	}
+
+	return ret;
+}
