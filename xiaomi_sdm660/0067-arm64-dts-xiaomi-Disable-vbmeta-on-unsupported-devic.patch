+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/jasmine.dtsi
@@ -15,6 +15,7 @@
 
 &firmware {
 	android {
+		/delete-node/ vbmeta;
 		fstab {
 			vendor {
 				mnt_flags = "ro,barrier=1";
diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm636.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm636.dtsi
