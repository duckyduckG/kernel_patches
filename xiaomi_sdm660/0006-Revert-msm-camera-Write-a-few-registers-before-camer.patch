 	struct msm_sensor_power_setting_array32 power_setting_array;
 	uint8_t  is_init_params_valid;
 	struct msm_sensor_init_params sensor_init_params;
@@ -161,6 +146,14 @@ struct msm_camera_i2c_seq_reg_setting32 {
