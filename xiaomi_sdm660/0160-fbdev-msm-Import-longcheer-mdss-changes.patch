+	}
+	ret=sysfs_create_file(msm_whitepoint,&dev_attr_whitepoint.attr);
+	if (ret) {
+		pr_info("%s failed \n",__func__);
+		kobject_del(msm_whitepoint);
+	}
+	return 0;
+}
+#endif
