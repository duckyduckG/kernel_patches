+	if ((strstr(g_lcd_id,"nt36672") != NULL)||(strstr(g_lcd_id,"nt36672a") != NULL)||(strstr(g_lcd_id,"td4320") != NULL))
+		ESD_TE_status = true;
+#endif
 		return -EINVAL;
 	} else {
 		return 1;
@@ -3270,6 +3393,70 @@ static int mdss_panel_parse_dt(struct device_node *np,
 	return -EINVAL;
 }
 
