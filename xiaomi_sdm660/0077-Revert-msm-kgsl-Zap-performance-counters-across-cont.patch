 drivers/gpu/msm/adreno_perfcounter.c  |  7 ++--
 drivers/gpu/msm/adreno_pm4types.h     |  7 ----
 drivers/gpu/msm/adreno_ringbuffer.c   |  3 +-
 7 files changed, 8 insertions(+), 89 deletions(-)

