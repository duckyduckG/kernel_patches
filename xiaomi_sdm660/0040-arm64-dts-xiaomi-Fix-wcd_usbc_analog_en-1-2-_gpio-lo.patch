From: Davide Garberi <dade.garberi@gmail.com>
Date: Fri, 27 Sep 2019 16:39:27 +0200
Subject: [PATCH 040/178] arm64: dts: xiaomi: Fix wcd_usbc_analog_en{1/2}_gpio
 location

Change-Id: I40752b630039ca70359305a382e3b00f4191a8f9
---
 .../qcom/xiaomi/longcheer/common/longcheer-sdm660-audio.dtsi   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-audio.dtsi b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-audio.dtsi
index 91af220d9037..62cd57b854b4 100644
--- a/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-audio.dtsi
+++ b/arch/arm64/boot/dts/vendor/qcom/xiaomi/longcheer/common/longcheer-sdm660-audio.dtsi
@@ -37,13 +37,14 @@
 			&pri_mi2s_sd0_sleep &pri_mi2s_sd1_sleep>;
 };
 
-&wcd_rst_gpio {
+&soc {
 	wcd_usbc_analog_en1_gpio: msm_cdc_pinctrl_usbc_audio_en1 {
 		compatible = "qcom,msm-cdc-pinctrl";
 		pinctrl-names = "aud_active", "aud_sleep";
 		pinctrl-0 = <&wcd_usbc_analog_en1_active>;
 		pinctrl-1 = <&wcd_usbc_analog_en1_idle>;
 	};
+
 	wcd_usbc_analog_en2n_gpio: msm_cdc_pinctrl_usbc_audio_en2 {
 		compatible = "qcom,msm-cdc-pinctrl";
 		pinctrl-names = "aud_active", "aud_sleep";
