index 000000000000..e3d8ecb410ff
--- /dev/null
+++ b/drivers/media/platform/msm/camera_v2-legacy/isp/msm_isp48.c
@@ -0,0 +1,506 @@
+/* Copyright (c) 2016-2017, The Linux Foundation. All rights reserved.
+ *
