+		vfe_dev->hw_info->vfe_ops.irq_ops.config_irq(vfe_dev,
+				1 << 15, 1 << 24, MSM_ISP_IRQ_ENABLE);
+		break;
+	case STATS_COMP_IDX_HDR_BE:
+		vfe_dev->hw_info->vfe_ops.irq_ops.config_irq(vfe_dev,
