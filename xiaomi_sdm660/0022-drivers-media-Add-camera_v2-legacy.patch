+static int32_t msm_camera_tz_i2c_ta_probe(
+	struct msm_camera_i2c_client *client)
+{
+	int32_t sensor_id = -1;
+
+	CDBG("Enter\n");
+	sensor_id = msm_camera_tz_i2c_is_sensor_secure(client);
+	if ((sensor_id >= 0) &&
+		(sensor_id < MAX_CAMERAS) &&
+		(sensor_info[sensor_id].ready != 0)) {
+		msm_camera_tz_lock();
+		return sensor_id;
+	}
+	return -EINVAL;
+}
