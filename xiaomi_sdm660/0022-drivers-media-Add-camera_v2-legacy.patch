+				stream_info);
+
+	msm_vfe46_config_irq(vfe_dev,
+		1 << (STATS_IDX(stream_info->stream_handle[vfe_idx]) + 15), 0,
+		MSM_ISP_IRQ_ENABLE);
+}
+
