From 1c1309337b8449e3a4d18accbc9268d5cad0c5a5 Mon Sep 17 00:00:00 2001
From: Davide Garberi <dade.garberi@gmail.com>
Date: Wed, 21 Aug 2019 15:33:43 +0200
Subject: [PATCH 162/178] init: Import xiaomi longcheer changes

Change-Id: I4926f9aac45e2fa3ef090d972b2ccc8ab5c5ab7b
---
 init/main.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/init/main.c b/init/main.c
index c1b2e6c6cdf1..99ece624ed3d 100644
--- a/init/main.c
+++ b/init/main.c
@@ -552,10 +552,17 @@ static void __init mm_init(void)
 	pti_init();
 }
 
+#ifdef CONFIG_MACH_LONGCHEER
+int fpsensor = 1;
+bool is_poweroff_charge = false;
+#endif
 asmlinkage __visible void __init start_kernel(void)
 {
 	char *command_line;
 	char *after_dashes;
+#ifdef CONFIG_MACH_LONGCHEER
+	char *p = NULL;
+#endif
 
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
@@ -587,6 +594,21 @@ asmlinkage __visible void __init start_kernel(void)
 	pr_notice("Kernel command line: %s\n", boot_command_line);
 	/* parameters may set static keys */
 	jump_label_init();
+
+#ifdef CONFIG_MACH_LONGCHEER
+	p = NULL;
+	p = strstr(boot_command_line, "androidboot.fpsensor=fpc");
+	if (p)
+		fpsensor = 1;
+	else
+		fpsensor = 2;
+
+	p = NULL;
+	p = strstr(boot_command_line, "androidboot.mode=charger");
+	if (p)
+		is_poweroff_charge = true;
+#endif
+
 	parse_early_param();
 	after_dashes = parse_args("Booting kernel",
 				  static_command_line, __start___param,
-- 
2.49.0

